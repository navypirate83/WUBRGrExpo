# Copy this file to ".env" and fill in your own values. Never commit ".env".
PORT=4100
# Your MongoDB Atlas connection string (the database name goes after the last slash)
MONGODB_URI=
# A long random text. Make one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Changing it later signs everybody out. Use a DIFFERENT one from other projects.
JWT_SECRET=
# The app's Google client id(s), separated by commas (used to check Google tokens)
GOOGLE_CLIENT_ID=
# Websites allowed to call this server from a browser, exact addresses separated
# by commas (https, host and port only, no trailing slash). "*" is never allowed.
CORS_ORIGINS=
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5
# Optional: where the automated tests run (the name must end in "test")
# MONGODB_TEST_URI=
TEST_DB_NAME=wubgr-test

# Email for "Forgot username/password" (Resend: https://resend.com, free plan).
# Leave both empty to switch the feature off (the route then answers 503).
RESEND_API_KEY=
MAIL_FROM=

{
  "name": "wubrgr",
  "version": "0.2.0",
  "private": true,
  "description": "WUBRG'r: a Magic: The Gathering card binder app for phones (iPhone and Android) and the web, built with Expo.",
  "homepage": "https://navypirate83.github.io/WUBRGrExpo/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/navypirate83/WUBRGrExpo.git"
  },
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "dev": "expo start --web --port 3000",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export -p web && node scripts/finish-web-build.js",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.105.0",
    "expo": "~58.0.21",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.15",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.28",
    "expo-sharing": "~58.0.21",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}

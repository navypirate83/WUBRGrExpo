{
  "expo": {
    "name": "WUBRG'r",
    "slug": "wubrgrexpo",
    "owner": "navypirate83",
    "version": "0.2.0",
    "description": "A Magic: The Gathering card binder: keep your cards in binders that look and work like real ones, and find any card with the MTG Card Finder.",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "wubrgr",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#14151a",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.github.navypirate83.wubrgr"
    },
    "android": {
      "package": "io.github.navypirate83.wubrgr",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#14151a"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "WUBRG'r",
      "shortName": "WUBRG'r",
      "themeColor": "#14151a",
      "backgroundColor": "#14151a"
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#14151a",
          "image": "./assets/images/icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#14151a"
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/WUBRGrExpo"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "c1ffc910-496d-4ad3-92d1-212246e8606e"
      }
    }
  }
}
